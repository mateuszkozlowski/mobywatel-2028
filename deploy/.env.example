PUBLIC_HOST=mobywatel.mateuszkozlowski.xyz
PUBLIC_ORIGINS=https://mobywatel.mateuszkozlowski.xyz
CIVIC_RELEASE=local
CIVIC_AI_PROVIDER=publicai
CIVIC_CLOUD_MODEL=speakleash/Bielik-11B-v3.0-Instruct
PUBLICAI_BASE_URL=https://api.publicai.co/v1
PUBLICAI_API_KEY=
# USD ledger, separate from previous CloudFerro EUR spending. No automatic top-up.
CIVIC_AI_CURRENCY=USD
CIVIC_AI_MONTHLY_LIMIT=1.00
CIVIC_AI_INPUT_PER_M=0.40
CIVIC_AI_OUTPUT_PER_M=0.40
# Optional CloudFerro alternative: CIVIC_AI_PROVIDER=cloudferro, currency EUR,
# SHERLOCK_BASE_URL=https://api-sherlock.cloudferro.com/openai/v1,
# SHERLOCK_API_KEY, input/output 0.20/0.30 and a separately chosen EUR limit.
